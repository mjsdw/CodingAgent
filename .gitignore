# ===== 敏感信息（含密钥，严禁入库）=====
.env
**/.env
.env.local
**/.env.local

# ===== Python 虚拟环境 =====
.venv/
venv/
env/

# ===== Python 缓存与编译产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so

# ===== Chroma 向量库数据（生成产物，可由 build_db.py 重建）=====
simple/db/

# ===== 运行时数据（记忆/上传/快照，含用户内容）=====
simple/data/memory.db
simple/data/workspace/

# ===== IDE =====
.idea/
.vscode/
*.swp

